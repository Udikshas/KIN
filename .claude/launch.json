{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8099"
      ],
      "port": 8099
    }
  ]
}