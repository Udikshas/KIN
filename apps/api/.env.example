# Copy to .env for local dev. In Coolify set these on the kin-api app
# (Environment Variables → Developer view accepts these lines as-is).
# Format: KEY=value, no quotes, no spaces around =, no trailing slash on URLs.
# Never commit real keys or tokens. The IDs below are not secrets.

# Web origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=https://kin.garcade.in,http://localhost:3000
# Port uvicorn listens on (Docker image default 8000).
PORT=8000

# SuperTokens (auth)
# kin-supertokens has the Coolify network alias "supertokens" (General → Networking).
# Local dev: http://localhost:3567
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
# Same value as API_KEYS on kin-supertokens. Generate with: openssl rand -hex 32
SUPERTOKENS_API_KEY=
# Public URLs, used by SuperTokens for cookies and links.
API_DOMAIN=https://api.kin.garcade.in
WEBSITE_DOMAIN=https://kin.garcade.in
# Sign-in code email (app/auth_email.py: Kin design, code in the subject). Without
# SMTP_HOST, SuperTokens' plain default email is sent from noreply@supertokens.io.
# Port 587 = STARTTLS, 465 = SSL. Any SMTP provider works (Resend, Brevo, SES, Gmail app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kin <hello@kin.garcade.in>

# Postgres: waitlist sign-ups (table created automatically on first use).
# kin-postgres → "Postgres URL (internal)", with the database changed to /kin.
DATABASE_URL=postgres://kin:CHANGE_ME@<postgres-internal-host>:5432/kin

# Sarvam chat / speech APIs (dashboard.sarvam.ai → API Keys, sk_...). Used by sarvam_hello.py.
SARVAM_API_KEY=

# Sarvam Voice Agents → Instant Outbound. Used by place_call.py.
# Separate key: apps.sarvam.ai → Settings → API Key (sent as X-API-Key).
SARVAM_APPS_API_KEY=
SARVAM_ORG_ID=01a121aa-22c9-7630-901d-dc4e99cbab77
SARVAM_WORKSPACE_ID=01a121aa-22cd-766d-951b-5ca6ab65144f
# Agent "Kin Agent" (id stays Kin-Evening-...). Its version is pinned in app/sarvam_outbound.py
# (AGENT_VERSION); set SARVAM_APP_VERSION only to override it, e.g. a quick rollback.
SARVAM_APP_ID=Kin-Evening-6c657418-97eb
# SARVAM_APP_VERSION=
# Sarvam Vobiz connection and the rented Kin number.
SARVAM_CONNECTION_ID=17913054-31-b804bd45-9f17
SARVAM_AGENT_PHONE=+917971413869
# Public base URL of this API (tunnel URL locally).
PUBLIC_API_URL=https://api.kin.garcade.in

# Webhook secret, sent in webhook_config.metadata.token. Generate with: openssl rand -hex 32
# Use the same value locally and on Coolify so place_call.py works against the live API.
SARVAM_WEBHOOK_TOKEN=
# On-start hook (/hooks/on-start) secret, sent by Sarvam in X-Hook-Token. Also set in the agent's on_start_config.
SARVAM_HOOK_TOKEN=
# Medicine reminder calls without the AI (app/ivr.py): a recorded clip and "press 1" through
# your own Vobiz account (console.vobiz.ai, KYC with Aadhaar + PAN) and a number you bought there.
# All three set = reminders ring through Vobiz (~₹0.45/min); unset = the Sarvam agent rings them.
# The clips are spoken once with SARVAM_API_KEY (Bulbul text-to-speech).
# VOBIZ_AUTH_ID=
# VOBIZ_AUTH_TOKEN=
# VOBIZ_FROM_NUMBER=+91...
# Where webhook payloads are stored until Postgres is wired up (/app/data volume in Docker).
SARVAM_CALLS_FILE=data/sarvam_calls.jsonl
# Claude API for after-call summaries (not used yet).
ANTHROPIC_API_KEY=

# Server-to-server secret from kin-web (X-Web-Token) for /waitlist and /demo/calls.
# Same value as WEB_API_TOKEN on kin-web. Generate with: openssl rand -hex 32
WEB_API_TOKEN=
# Wallet protection: total demo calls per hour, and seconds before the same number can be called again.
DEMO_MAX_CALLS_PER_HOUR=10
DEMO_NUMBER_COOLDOWN_S=180
# Demo credit (Kin's own estimate, not Sarvam's wallet): rupees per started minute,
# rupees available for Try-it calls, and when that amount was loaded (calls before
# it don't count). Leave DEMO_CREDITS empty for no limit.
DEMO_RATE_PER_MIN=5
DEMO_CREDITS=70
DEMO_CREDITS_SINCE=2026-10-30T00:00:00+05:30
# App "Ask Kin to call now": seconds before the same number can be called again,
# and calls per family per day (India time).
APP_CALL_COOLDOWN_S=600
APP_CALLS_PER_DAY=5
# Daily calls (app/scheduler.py): places real calls every evening for parents whose
# family turned "Daily calls" on in the app. Off unless set to 1.
SCHEDULER_ENABLED=
# Expo Push API access token, only if "enhanced push security" is on in the Expo dashboard.
EXPO_ACCESS_TOKEN=

# Refill alerts when a medicine runs low (app/stock.py), checked every 30 min, 9 am-8 pm IST.
# On by default; 0 turns them off.
STOCK_ALERTS=
