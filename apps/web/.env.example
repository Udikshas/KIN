# Copy to .env.local for local dev. In Coolify set these on the kin-web app.

# Public site URL, used for metadataBase and share previews.
# Coolify: tick "Build Variable" (NEXT_PUBLIC_* is inlined at build time).
NEXT_PUBLIC_SITE_URL=https://kin.example.com

# Waitlist sign-ups go to Postgres via the API (needs WEB_API_TOKEN + KIN_API_URL).
# Fallback when the API is unreachable: appended here as JSON lines (persistent volume).
# Leave unset locally (falls back to apps/web/data/). The Docker image sets /data/waitlist.jsonl.
# WAITLIST_FILE=/data/waitlist.jsonl

# Try-it demo at /try (password-protected page that places a real Kin call).
# Leave DEMO_PASSWORD empty to switch the demo off. Runtime variables, not build variables.
DEMO_PASSWORD=
# Shared secret the web server sends to the API (X-Web-Token) for the waitlist and the demo.
# Same value as WEB_API_TOKEN on kin-api. Generate with: openssl rand -hex 32
WEB_API_TOKEN=
# Where the web server reaches the API (server-side only).
KIN_API_URL=https://api.kin.garcade.in
